"""[[.Name]]: an OmniAgent service generated by `omni new service`."""

from __future__ import annotations

import logging
import os
import signal
import threading
import time
from contextlib import asynccontextmanager

from fastapi import FastAPI, Request, Response
from prometheus_client import CONTENT_TYPE_LATEST, Counter, Histogram, generate_latest

SERVICE = "[[.Name]]"
VERSION = os.environ.get("SERVICE_VERSION", "dev")
METRIC = SERVICE.replace("-", "_")

REQUESTS = Counter(f"{METRIC}_requests_total", "HTTP requests", ["path", "status"])
LATENCY = Histogram(f"{METRIC}_request_seconds", "HTTP request latency", ["path"])

log = logging.getLogger(SERVICE)


class State:
    ready = False


@asynccontextmanager
async def lifespan(_: FastAPI):
    # Fail readiness as soon as SIGTERM arrives so load balancers stop routing
    # here while uvicorn drains in-flight requests, then hand the signal on to
    # uvicorn's own handler. Signal handlers can only be set on the main thread
    # (test clients run lifespan elsewhere).
    if threading.current_thread() is threading.main_thread():
        previous = signal.getsignal(signal.SIGTERM)

        def on_term(signum, frame):
            State.ready = False
            if callable(previous):
                previous(signum, frame)

        signal.signal(signal.SIGTERM, on_term)
    State.ready = True
    yield
    State.ready = False


app = FastAPI(title=SERVICE, version=VERSION, lifespan=lifespan)


@app.middleware("http")
async def observe(request: Request, call_next):
    start = time.perf_counter()
    response = await call_next(request)
    route = request.scope.get("route")
    path = route.path if route else "unmatched"
    REQUESTS.labels(path, str(response.status_code)).inc()
    LATENCY.labels(path).observe(time.perf_counter() - start)
    return response


@app.get("/healthz")
async def healthz() -> dict:
    return {"status": "ok"}


@app.get("/readyz")
async def readyz(response: Response) -> dict:
    if not State.ready:
        response.status_code = 503
    return {"ready": State.ready}


@app.get("/metrics")
async def metrics() -> Response:
    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)


@app.get("/v1/info")
async def info() -> dict:
    return {"service": SERVICE, "version": VERSION}
