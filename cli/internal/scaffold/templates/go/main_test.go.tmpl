package main

import (
	"io"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

func newServer() (*server, *httptest.Server) {
	s := &server{log: slog.New(slog.NewTextHandler(io.Discard, nil))}
	return s, httptest.NewServer(s.routes())
}

func get(t *testing.T, url string) (int, string) {
	t.Helper()
	resp, err := http.Get(url)
	if err != nil {
		t.Fatal(err)
	}
	defer resp.Body.Close()
	body, _ := io.ReadAll(resp.Body)
	return resp.StatusCode, string(body)
}

func TestHealthAndReadiness(t *testing.T) {
	s, ts := newServer()
	defer ts.Close()
	if code, _ := get(t, ts.URL+"/healthz"); code != http.StatusOK {
		t.Fatalf("healthz = %d", code)
	}
	if code, _ := get(t, ts.URL+"/readyz"); code != http.StatusServiceUnavailable {
		t.Fatalf("readyz before start = %d, want 503", code)
	}
	s.ready.Store(true)
	if code, _ := get(t, ts.URL+"/readyz"); code != http.StatusOK {
		t.Fatalf("readyz after start = %d", code)
	}
}

func TestInfoAndMetrics(t *testing.T) {
	_, ts := newServer()
	defer ts.Close()
	if code, body := get(t, ts.URL+"/v1/info"); code != http.StatusOK || !strings.Contains(body, service) {
		t.Fatalf("info = %d %s", code, body)
	}
	_, body := get(t, ts.URL+"/metrics")
	if !strings.Contains(body, metric+"_requests_total 1") {
		t.Fatalf("metrics did not count the info request:\n%s", body)
	}
}
