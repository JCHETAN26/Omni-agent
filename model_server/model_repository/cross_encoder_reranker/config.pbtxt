# Cross-encoder reranker: cross-encoder/ms-marco-MiniLM-L-6-v2 exported to ONNX.
# One request carries all (query, passage) pairs for a search, so a single
# rerank call is already a batch; dynamic batching additionally merges pairs
# from concurrent searches that share a length bucket.
name: "cross_encoder_reranker"
backend: "onnxruntime"
max_batch_size: 64

input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "token_type_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 32, 64 ]
  max_queue_delay_microseconds: 5000
}

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

# onnxruntime backend: threads per model instance (intra-op parallelism).
parameters {
  key: "intra_op_thread_count"
  value: { string_value: "4" }
}
