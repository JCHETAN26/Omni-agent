# Sentence embedder: sentence-transformers/all-MiniLM-L6-v2 exported to ONNX with
# mean pooling + L2 normalisation baked into the graph (see model_server/export_onnx.py).
#
# Requests are tokenised client-side and padded to a fixed length bucket
# (32/64/128/256 tokens). Triton only batches requests with identical shapes,
# so bucketing is what lets the dynamic batcher merge concurrent requests.
name: "minilm_embedder"
backend: "onnxruntime"
max_batch_size: 64

input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

output [
  {
    name: "sentence_embedding"
    data_type: TYPE_FP32
    dims: [ 384 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 16, 32, 64 ]
  max_queue_delay_microseconds: 5000
}

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

# onnxruntime backend: threads per model instance (intra-op parallelism).
parameters {
  key: "intra_op_thread_count"
  value: { string_value: "2" }
}
