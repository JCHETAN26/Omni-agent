# Leave any service URL empty to use its container-free fallback.

# Qdrant Cloud (empty -> embedded in-memory Qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=omniagent_chunks

# Elasticsearch (empty -> in-process BM25 index)
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=omniagent_chunks

# Redis (empty -> in-memory cache)
REDIS_URL=
CACHE_TTL_SECONDS=300

# Embeddings: sentence-transformers | openai | triton | hashing (offline test-only)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RRF_K=60
RETRIEVAL_CANDIDATES=50
RERANK_ENABLED=false
RERANK_CANDIDATES=10
RERANK_TIMEOUT_S=1.5

# Model inference: mock (in-process) | triton (gRPC)
INFERENCE_BACKEND=mock
TRITON_GRPC_URL=localhost:8001
TRITON_TIMEOUT_S=10
TRITON_MAX_IN_FLIGHT=128

# Agent (LangGraph). LLM_PROVIDER: heuristic (offline) | anthropic | openai (OpenAI/vLLM)
LLM_PROVIDER=heuristic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=60
AGENT_MAX_RETRIES=2
AGENT_RELEVANCE_THRESHOLD=0.5
AGENT_GROUNDING_THRESHOLD=0.6
AGENT_TOP_K=4
AGENT_HISTORY_MESSAGES=8
AGENT_MEMORY_TTL_S=604800
AGENT_LOGS_PATH=samples/logs

# WebSocket gateway
WS_MAX_SESSIONS=1000
WS_BUFFER_SIZE=256
WS_MAX_MESSAGE_BYTES=1048576
WS_HEARTBEAT_INTERVAL_S=15
WS_HEARTBEAT_TIMEOUT_S=45

# Token-bucket rate limit per WebSocket session (Redis-backed when REDIS_URL is set)
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_S=10
RATE_LIMIT_AUDIO_COST=0.05

# Observability
LOG_FORMAT=json
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
