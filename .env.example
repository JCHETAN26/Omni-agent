# Leave any service URL empty to use its container-free fallback.

# Qdrant Cloud (empty -> embedded in-memory Qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=omniagent_chunks

# Elasticsearch (empty -> in-process BM25 index)
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=omniagent_chunks

# Redis (empty -> in-memory cache)
REDIS_URL=
CACHE_TTL_SECONDS=300

# Embeddings: sentence-transformers | openai | hashing (offline test-only)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RRF_K=60
RETRIEVAL_CANDIDATES=50
